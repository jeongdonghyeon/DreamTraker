<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingBottom="24dp"> <LinearLayout
    android:layout_width="40dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/ivStageIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/sleep"
        android:contentDescription="수면 단계 아이콘"
        app:tint="#FFFFFF" />

    <View
        android:id="@+id/vStageLine"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="#9494C7"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="-24dp"/> </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tvStageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="건강한 수면"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="건강한 수면"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

</LinearLayout>